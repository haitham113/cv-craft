{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement",
          "weight",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "enum": [
              "met",
              "partially_met",
              "not_met",
              "unverified"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
